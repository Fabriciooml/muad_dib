{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cinema tracker output V1",
  "description": "Validates one preview response or one Kafka session discovery payload.",
  "oneOf": [
    {
      "$ref": "#/$defs/preview_response"
    },
    {
      "$ref": "#/$defs/discovery_event"
    }
  ],
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "movie_id",
        "city",
        "cinema_id",
        "cinema",
        "room",
        "date",
        "time",
        "timezone",
        "format",
        "language",
        "purchase_url"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "movie_id": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "cinema_id": {
          "type": "string",
          "minLength": 1
        },
        "cinema": {
          "type": "string",
          "minLength": 1
        },
        "room": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "purchase_url": {
          "type": "string",
          "pattern": "^https?://",
          "format": "uri"
        }
      }
    },
    "preview_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "movie_title",
        "providers",
        "filters",
        "partial",
        "checked_at",
        "count",
        "provider_results",
        "sessions"
      ],
      "properties": {
        "movie_title": {
          "type": "string",
          "minLength": 1
        },
        "providers": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "city",
            "cinema",
            "room"
          ],
          "properties": {
            "city": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "cinema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "room": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "partial": {
          "type": "boolean"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "provider_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "status",
              "movie_id"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "success",
                  "not_found",
                  "ambiguous",
                  "source_error"
                ]
              },
              "movie_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session"
          }
        }
      }
    },
    "discovery_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "schema_version",
        "observed_at",
        "provider",
        "movie_id",
        "city",
        "cinema_id",
        "cinema",
        "room",
        "date",
        "time",
        "timezone",
        "format",
        "language",
        "purchase_url"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "const": "session.discovered"
        },
        "schema_version": {
          "const": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "movie_id": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "cinema_id": {
          "type": "string",
          "minLength": 1
        },
        "cinema": {
          "type": "string",
          "minLength": 1
        },
        "room": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "purchase_url": {
          "type": "string",
          "pattern": "^https?://",
          "format": "uri"
        }
      }
    }
  }
}
